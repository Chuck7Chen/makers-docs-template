# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode/
.idea/

# lock files (templates resolve dependencies at deploy time)
package-lock.json
yarn.lock
pnpm-lock.yaml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# edgeone makers
.edgeone/

# local stand-in for Blob storage during development
/.blob-local/

# typescript
*.tsbuildinfo
next-env.d.ts
